0:["EpKlPHGKQqmkds0P76ane",[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"min-h-screen bg-[#FCFCF9] text-[#1A1A1A] font-sans","children":["$","div",null,{"className":"max-w-[640px] mx-auto px-6 py-16 md:py-24","children":[["$","h1",null,{"className":"text-[1.75rem] md:text-[2.25rem] leading-[1.15] font-bold mb-4","children":"You spent months perfecting your product."}],["$","h1",null,{"className":"text-[1.75rem] md:text-[2.25rem] leading-[1.15] font-bold mb-10","children":"Then you filmed it on your phone and put it on Instagram."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":["$","strong",null,{"children":"Hey."}]}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":"We've all done it. The product is ready. The website is live. Someone says \"put up a video.\" So you grab your iPhone, shoot 20 seconds of the product on your desk, add trending audio, and hit post."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":"And nothing happens."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":[["$","strong",null,{"children":"Here's what's actually happening:"}]," when someone lands on your Instagram or your product page and sees phone footage with bad lighting and no story, their brain registers one thing — ",["$","em",null,{"children":"small brand"}],". Not premium. Not trustworthy. Not \"I should pay full price for this.\""]}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":"A real commercial shoot costs ₹2–5 lakh. Crew, location, lighting, talent, editing, revisions. Most DTC founders can't justify that until they're doing crores in revenue. So they stay stuck with phone footage, wondering why their conversion rate won't move."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":[["$","strong",null,{"children":"We built a way around it."}]," AI-produced brand commercials — the kind that make people stop scrolling and ask \"who shot this?\" — for about the price of one month's ad spend."]}],["$","p",null,{"className":"text-lg leading-relaxed mb-8","children":"But first: is your current video even the problem? Grab our free scorecard. 8 questions. 3 minutes. You'll know exactly where you stand."}],["$","div",null,{"className":"border-2 border-[#1A1A1A] p-6 md:p-8 mb-8","children":[["$","h2",null,{"className":"text-xl font-bold mb-2","children":"The DTC Commercial Scorecard"}],["$","p",null,{"className":"text-base leading-relaxed mb-4","children":"Free 8-point audit. Is your product video helping you sell, or is it the reason people bounce? Answer 8 yes/no questions and see your score instantly."}],["$","ul",null,{"className":"space-y-2 mb-6 text-base","children":[["$","li",null,{"children":"✓ Takes 3 minutes. Check boxes. Done."}],["$","li",null,{"children":["✓ You'll know ",["$","strong",null,{"children":"exactly"}]," whether your video is costing you sales"]}],["$","li",null,{"children":"✓ Instant PDF download — no pitch, no webinar, no catch"}]]}],["$","form",null,{"action":"/api/lead","method":"POST","className":"space-y-3","children":[["$","input",null,{"type":"email","name":"email","placeholder":"Your email — I'll send the scorecard right now","required":true,"className":"w-full px-4 py-3 border-2 border-[#1A1A1A] bg-white text-base focus:outline-none focus:ring-2 focus:ring-[#1A1A1A]"}],["$","input",null,{"type":"url","name":"website","placeholder":"Your website or Instagram (optional — so we can see your current video)","className":"w-full px-4 py-3 border-2 border-[#1A1A1A] bg-white text-base focus:outline-none focus:ring-2 focus:ring-[#1A1A1A]"}],["$","button",null,{"type":"submit","className":"w-full py-3 bg-[#1A1A1A] text-white font-bold text-base hover:bg-[#333] transition-colors","children":"Send Me the Free Scorecard →"}]]}],["$","p",null,{"className":"text-sm text-[#666] mt-3","children":"No spam. No pitches. Just the scorecard."}]]}],["$","div",null,{"className":"space-y-4 text-sm text-[#555] leading-relaxed","children":[["$","p",null,{"children":["$","strong",null,{"children":"\"AI-produced? Is this just cheap AI slop?\""}]}],["$","p",null,{"children":"Fair question. It's not. We don't type a prompt and ship whatever comes out. We use Seedance — the same AI video engine ByteDance built — but we direct it like a real shoot. Reference images. Shot composition. Color grade. We iterate until it looks like someone spent ₹2 lakh on a crew. The AI is the camera. We're the directors."}],["$","p",null,{"children":["We've already done this for skincare, watches, and short film concepts. The spec work is at ",["$","a",null,{"href":"https://instagram.com/nikocreativelabs","className":"underline","children":"@nikocreativelabs"}]," — go see for yourself."]}],["$","p",null,{"children":["$","strong",null,{"children":"\"What's in it for you?\""}]}],["$","p",null,{"children":"We're betting that after you see the scorecard — and after you compare your current video to what's possible — you'll want us to make one for your brand. That's the business. But the scorecard is genuinely free, genuinely useful, and has no pitch inside. If you never talk to us again, you still walk away knowing whether your video is the problem. That's worth 3 minutes."}]]}],["$","p",null,{"className":"text-xs text-[#999] mt-16","children":"Niko Creative Labs, Hyderabad. AI-produced brand commercials. No spam, ever."}]]}]}]],null],null]},[["$","html",null,{"lang":"en","className":"__variable_f367f3 __variable_315a98 __variable_3c557b","children":["$","body",null,{"className":"bg-paper text-ink","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not