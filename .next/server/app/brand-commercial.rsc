className":"border-t border-[#ddd] pt-6 mb-8","children":[["$","h3",null,{"className":"font-bold text-base mb-2","children":"A note on waiting"}],["$","p",null,{"className":"text-sm leading-relaxed text-[#555] mb-2","children":"Every month you stay with phone footage, you're paying Instagram ads to send people to content that doesn't convert. If your CAC is ₹300 and your conversion rate could improve 30% with better creative — that's real money. More than the package costs."}],["$","p",null,{"className":"text-sm leading-relaxed text-[#555]","children":["The brands that win in DTC aren't the ones with the best products. They're the ones that ",["$","strong",null,{"children":"look like the best products."}]," The gap between what your product IS and what it LOOKS LIKE — that's the gap this package closes. Don't wait until your competitor closes theirs first."]}]]}],["$","div",null,{"className":"border-t-2 border-[#1A1A1A] pt-6","children":[["$","p",null,{"className":"text-sm leading-relaxed text-[#555] mb-2","children":[["$","strong",null,{"children":"P.S."}]," The ₹999 Spec is the only way in. We don't take cold DMs for the full package — we want you to see what your product looks like first, so you're not buying blind. Grab the Spec. See your product the way customers should see it. Then decide."]}],["$","a",null,{"href":"https://rzp.io/l/niko-spec","target":"_blank","rel":"noopener noreferrer","className":"inline-block py-2 px-4 bg-[#1A1A1A] text-white font-bold text-sm hover:bg-[#333] transition-colors","children":"Grab the ₹999 Spec →"}]]}],["$","p",null,{"className":"text-xs text-[#999] mt-16","children":"Niko Creative Labs, Hyderabad. AI-produced commercials, human-directed."}]]}]}]],null],null]},["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","brand-commercial","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefin