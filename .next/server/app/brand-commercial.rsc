0:["EpKlPHGKQqmkds0P76ane",[[["",{"children":["brand-commercial",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["brand-commercial",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"min-h-screen bg-[#FCFCF9] text-[#1A1A1A] font-sans","children":["$","div",null,{"className":"max-w-[680px] mx-auto px-6 py-16 md:py-24","children":[["$","h1",null,{"className":"text-[1.75rem] md:text-[2.5rem] leading-[1.15] font-bold mb-6","children":["$","strong",null,{"children":"Your product is good enough to sell itself."}]}],["$","h2",null,{"className":"text-[1.3rem] md:text-[1.5rem] leading-[1.3] mb-10 text-[#333]","children":"The problem is your video looks like everyone else's — and that's why they scroll past without buying."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":["$","strong",null,{"children":"Hey."}]}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":"You know your product is better than the competition. You've seen theirs. The packaging is worse. The formulation is watered down. The build quality isn't close to yours. And yet — their Instagram Reels get 50k views and yours gets 400."}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":["You tell yourself it's the algorithm. But you pull up their video and your video side by side, and something sinks in: theirs ",["$","em",null,{"children":"looks like a brand"}],". Yours looks like someone filmed it in their living room. Which, to be fair, you did."]}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":[["$","strong",null,{"children":"A real commercial shoot costs ₹2-5 lakhs."}]," Crew. Lighting. A DOP who knows what they're doing. Location permits. Talent. Post-production. Revisions. For most DTC founders doing ₹5-50 lakhs a month, that math doesn't work. You'd have to sell 2,000 extra units just to break even on the video. So you stay stuck with phone footage, telling yourself you'll do it \"once we scale.\""]}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":["But here's the trap: ",["$","strong",null,{"children":"you can't scale without the commercial."}]," Better video → more trust → higher conversion → more revenue → now you can afford the traditional shoot. The video comes first. Not after."]}],["$","p",null,{"className":"text-lg leading-relaxed mb-8","children":["$","strong",null,{"children":"Until now, that was a real Catch-22. It's not anymore."}]}],["$","div",null,{"className":"border-2 border-[#1A1A1A] p-6 md:p-8 mb-10","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"The Brand Commercial Package"}],["$","p",null,{"className":"text-lg leading-relaxed mb-4","children":["Three AI-produced commercials for your brand — shot, directed, and edited like a real production house would. The difference is the camera is AI (Seedance, the same engine ByteDance built), and we're the directors — so your cost is roughly ",["$","strong",null,{"children":"one-tenth"}]," of a traditional shoot."]}],["$","div",null,{"className":"space-y-4 mb-6","children":[["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":[["$","p",null,{"className":"font-bold text-base","children":"1. The Product Hero (30 sec)"}],["$","p",null,{"className":"text-sm text-[#555]","children":"Your product as the star. Cinematic lighting, movement, detail shots. The one you pin to your Instagram and put on your landing page. Reference: watch commercials, premium skincare B-roll."}]]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":[["$","p",null,{"className":"font-bold text-base","children":"2. The Lifestyle Spot (30 sec)"}],["$","p",null,{"className":"text-sm text-[#555]","children":"Your product in context. Someone wearing it, using it, experiencing it. This is the \"I want that life\" video. Runs as your primary Instagram/YouTube ad creative."}]]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":[["$","p",null,{"className":"font-bold text-base","children":"3. The UGC Cut (30 sec)"}],["$","p",null,{"className":"text-sm text-[#555]","children":"Styled like organic user-generated content — but beautifully shot. The \"my friend recommended this\" energy that converts on TikTok and Reels. Feels authentic, looks expensive."}]]}]]}],["$","div",null,{"className":"border-t border-[#ddd] pt-4 mb-4","children":[["$","p",null,{"className":"font-bold text-base","children":"+ 5 Short-Form Cuts"}],["$","p",null,{"className":"text-sm text-[#555]","children":"Each commercial chopped into 15-30 second vertical formats for Reels, Shorts, and TikTok. Ready to post. No extra editing needed."}]]}],["$","div",null,{"className":"bg-[#F5F5F0] p-4 mb-5","children":[["$","p",null,{"className":"text-3xl font-bold mb-1","children":"₹24,999"}],["$","p",null,{"className":"text-sm text-[#555]","children":"One-time. All deliverables in 7-10 business days. Unlimited revisions within scope."}]]}],["$","a",null,{"href":"https://rzp.io/l/niko-core","target":"_blank","rel":"noopener noreferrer","className":"block w-full text-center py-3 bg-[#1A1A1A] text-white font-bold text-base hover:bg-[#333] transition-colors","children":"Get the Brand Commercial Package →"}]]}],["$","h3",null,{"className":"text-xl font-bold mb-4","children":"What changes after you get these videos"}],["$","div",null,{"className":"space-y-3 mb-8","children":[["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":["$","p",null,{"children":[["$","strong",null,{"children":"Your Instagram stops looking like a hobby and starts looking like a brand."}]," People who land on your profile see 3 pinned videos that look expensive. First impression: \"these guys are legit.\""]}]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":["$","p",null,{"children":[["$","strong",null,{"children":"Your ads actually convert."}]," Not because you changed the targeting — because the creative doesn't look like every other DTC ad in the feed. People stop, watch, click."]}]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":["$","p",null,{"children":[["$","strong",null,{"children":"You can charge more."}]," A ₹499 product with a premium commercial reads as a ₹999 product. Buyers pay for perception. Always have."]}]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":["$","p",null,{"children":[["$","strong",null,{"children":"Retailers and buyers take you seriously."}]," DM a buyer with a link to your site and they see a real brand, not a side hustle. That changes the conversation before you say a word."]}]}],["$","div",null,{"className":"border-l-4 border-[#1A1A1A] pl-4","children":["$","p",null,{"children":[["$","strong",null,{"children":"You stop feeling embarrassed about your content."}]," No more \"should I post this?\" hesitation. You're proud to put these up. That confidence shows in everything else you do."]}]}]]}],["$","h3",null,{"className":"text-xl font-bold mb-4","children":"See what we've made"}],["$","p",null,{"className":"text-base leading-relaxed mb-4","children":["We've done spec work for skincare, watches, and short films — all AI-produced, all directed like real shoots. See the results at ",["$","a",null,{"href":"https://instagram.com/nikocreativelabs","className":"underline","children":"@nikocreativelabs"}],"."]}],["$","p",null,{"className":"text-base leading-relaxed mb-4","children":[["$","strong",null,{"children":"What about your specific product?"}]," That's what the ₹999 Spec is for. Before you commit to the full package, we'll make a 15-second spec of YOUR product so you can see exactly what's possible. If you love it, we roll into the full package. If you don't, you take your ₹999 back and walk away with a free spec. No risk."]}],["$","div",null,{"className":"border-2 border-[#1A1A1A] p-5 mb-8","children":[["$","p",null,{"className":"font-bold text-base mb-2","chil